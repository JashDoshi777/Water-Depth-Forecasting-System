# =============================================================
# Water Depth Forecasting System — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.

# --- Database (NeonDB PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- External API Keys (Optional) ---
# StormGlass.io — optional secondary tidal data source (free: 10 req/day)
STORMGLASS_API_KEY=

# OpenTopography — optional GEBCO bathymetry API (free: 50 req/day)
OPENTOPOGRAPHY_API_KEY=

# --- App Settings ---
APP_ENV=development
APP_PORT=7860
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:7860

# --- Data Ingestion ---
WEATHER_REFRESH_MINUTES=60
MARINE_REFRESH_MINUTES=60
FLOOD_REFRESH_HOURS=6
